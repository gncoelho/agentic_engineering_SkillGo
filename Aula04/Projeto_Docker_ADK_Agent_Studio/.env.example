# Copie este arquivo para .env e preencha a chave.
# Nunca envie o arquivo .env para o Git.

GOOGLE_API_KEY=adicione_sua_chave_gemini
GOOGLE_MODEL=gemini-2.5-flash

# O Compose sobrescreve esta URL no serviço da interface.
A2A_EXCHANGE_CARD_URL=http://exchange-agent:8001/.well-known/agent-card.json

# O exemplo A2A ainda pode emitir avisos de recurso experimental.
ADK_SUPPRESS_A2A_EXPERIMENTAL_FEATURE_WARNINGS=true
