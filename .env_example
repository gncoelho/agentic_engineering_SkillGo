# =============================================================================
# Agentic Engineering - SkillGo
# Modelo de configuracao de ambiente
#
# COMO USAR
#   1. Copie este arquivo:   cp .env_example .env
#   2. Preencha os valores reais no .env
#   3. NUNCA comite o .env  (ele deve estar no .gitignore)
# =============================================================================


# -----------------------------------------------------------------------------
# ANTHROPIC (Claude) - OBRIGATORIO
# -----------------------------------------------------------------------------
# Provedor usado nos labs Aula01_Lab01_RAG e Aula01_Lab02_Tools, via ChatAnthropic.
# Pacote: pip install langchain-anthropic
# Gere a sua chave em: https://console.anthropic.com/settings/keys
# Formato esperado: sk-ant-api03-...
ANTHROPIC_API_KEY=

# Modelo padrao. Se nao definido, os notebooks usam claude-opus-5.
# Alternativas para reduzir custo: claude-sonnet-5, claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-5


# -----------------------------------------------------------------------------
# OPENAI (GPT) - OPCIONAL
# -----------------------------------------------------------------------------
# Provedor alternativo. Nao e necessario para rodar os labs da Aula 01.
# Pacote: pip install langchain-openai
#
#   from langchain_openai import ChatOpenAI
#   llm = ChatOpenAI(model="gpt-5")
#
# Gere a sua chave em: https://platform.openai.com/api-keys
# Formato esperado: sk-proj-...
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Embeddings da OpenAI (alternativa ao modelo local do Lab 01).
# Troca HuggingFaceEmbeddings por OpenAIEmbeddings: nao baixa modelo, mas e pago.
#   from langchain_openai import OpenAIEmbeddings
#   embeddings = OpenAIEmbeddings(model="text-embedding-3-small")
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Preencha apenas se usar Azure OpenAI ou um proxy/gateway compativel.
# OPENAI_BASE_URL=


# -----------------------------------------------------------------------------
# GOOGLE (Gemini) - OPCIONAL
# -----------------------------------------------------------------------------
# Provedor alternativo. Nao e necessario para rodar os labs da Aula 01.
# Pacote: pip install langchain-google-genai
#
#   from langchain_google_genai import ChatGoogleGenerativeAI
#   llm = ChatGoogleGenerativeAI(model="gemini-2.5-pro")
#
# ATENCAO ao nome da variavel: o LangChain (ChatGoogleGenerativeAI) le GOOGLE_API_KEY.
# O SDK google-genai puro aceita GEMINI_API_KEY. Mantenha as duas com o mesmo valor
# para evitar surpresa ao alternar entre as bibliotecas.
# Gere a sua chave em: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_MODEL=gemini-2.5-pro

# Embeddings do Gemini (outra alternativa ao modelo local do Lab 01).
#   from langchain_google_genai import GoogleGenerativeAIEmbeddings
#   embeddings = GoogleGenerativeAIEmbeddings(model="models/text-embedding-004")
# GOOGLE_EMBEDDING_MODEL=models/text-embedding-004


# -----------------------------------------------------------------------------
# XAI (Grok) - OPCIONAL
# -----------------------------------------------------------------------------
# Provedor alternativo. Nao e necessario para rodar os labs da Aula 01.
# Pacote: pip install langchain-xai
#
#   from langchain_xai import ChatXAI
#   llm = ChatXAI(model="grok-4")
#
# Gere a sua chave em: https://console.x.ai
# Formato esperado: xai-
# XAI_API_KEY= xai-
# XAI_MODEL=grok-4

# A API da xAI e compativel com o formato OpenAI. Se preferir usar ChatOpenAI
# apontando para la, use esta base URL (nesse caso a chave vai em api_key=).
# XAI_BASE_URL=https://api.x.ai/v1


# -----------------------------------------------------------------------------
# DEEPSEEK - OPCIONAL
# -----------------------------------------------------------------------------
# Provedor alternativo. Nao e necessario para rodar os labs da Aula 01.
# Pacote: pip install langchain-deepseek
#
#   from langchain_deepseek import ChatDeepSeek
#   llm = ChatDeepSeek(model="deepseek-chat")
#
# Modelos: deepseek-chat (uso geral) e deepseek-reasoner (raciocinio explicito).
# Gere a sua chave em: https://platform.deepseek.com/api_keys
# Formato esperado: sk-...
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# A API da DeepSeek tambem e compativel com o formato OpenAI.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# NOTA SOBRE O LAB 01 (RAG): nem a xAI nem a DeepSeek oferecem API de embeddings.
# Se usar Grok ou DeepSeek como LLM, mantenha os embeddings locais
# (HuggingFaceEmbeddings) ou use os da OpenAI/Google. Misturar provedores assim
# e normal: o LLM e o modelo de embedding sao pecas independentes do pipeline.


# -----------------------------------------------------------------------------
# OPCIONAL - LangSmith (observabilidade)
# -----------------------------------------------------------------------------
# Nao e usado pelos labs da Aula 01, mas ajuda muito a depurar chains e agentes:
# mostra cada chamada de LLM, cada tool call e o tempo de cada passo.
# Crie a chave em: https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-engineering-skillgo
